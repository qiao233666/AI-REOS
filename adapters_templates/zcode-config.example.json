{
  "hooks": {
    "enabled": true,
    "events": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "process",
              "command": "__AIOS_PYTHON__",
              "args": ["__AIOS_PROJECT_DIR__/aiops/checks/hooks/session_start_context.py"],
              "timeoutMs": 10000,
              "statusMessage": "AI-REOS: inject state pointer"
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "process",
              "command": "__AIOS_PYTHON__",
              "args": ["__AIOS_PROJECT_DIR__/aiops/checks/hooks/guard_destructive.py"],
              "timeoutMs": 5000,
              "statusMessage": "AI-REOS: destructive command guard"
            }
          ]
        }
      ]
    }
  }
}
